  "families": {
    "Ingress": {
      "real_actors": [
        "ingress",
        "archive reader/writer"
      ],
      "fault_plan": "Stall or close publication, receipt and lookup peers; reopen real temporary archive storage after missing/corrupt records.",
      "recovery_invariants": "Exact submit hash, bounded fallback/refusal, no invented receipt, replay resumes from the retained cursor.",
      "remaining_real_dependencies": "Real archive/media-driver integration and process restart remain required."
    },
    "Sequencer": {
      "real_actors": [
        "sequencer admission",
        "validator replay"
      ],
      "fault_plan": "Stall intake and lookup replies; disconnect or backpressure orderer output; lose acknowledgements and renew sessions; restart replay from real checkpoints.",
      "recovery_invariants": "Preserve sender order and exact bytes, bound queues, recover without new client input, stop cleanly; validator verifies canonical state.",
      "remaining_real_dependencies": "Replica racing, process restart, validator checkpoint selection and sustained catch-up are not covered by the first admission fixture."
    },
    "Cluster": {
      "real_actors": [
        "Java sealer",
        "Aeron Cluster peers"
      ],
      "fault_plan": "Run real consensus members in a small local group; fail transports or members, vary delay/loss, reopen member storage.",
      "recovery_invariants": "One leader per term, quorum admission, consistent canonical order, replay/catch-up, and bounded recovery.",
      "remaining_real_dependencies": "Mocking an elected leader or accepted consensus result cannot validate elections, partition safety or primary replacement; real consensus/network scheduling is required."
    },
    "Fleet": {
      "real_actors": [
        "executor",
        "state writer",
        "state mirror",
        "Redis/Sentinel",
        "sealer"
      ],
      "fault_plan": "Stop and restart the affected real actor group; delete only its owned test storage and feed retained checkpoint/log or authoritative upstream data.",
      "recovery_invariants": "Exact state and receipt parity, complete rebuild coverage before serving, bounded recovery, no stale balance rejection.",
      "remaining_real_dependencies": "Redis promotion requires real Redis/Sentinel processes; total consensus/storage loss requires real persistence and quorum members."
    },
    "Coordinated": {
      "real_actors": [
        "ingress",
        "sequencer",
        "executor",
        "discovery"
      ],
      "fault_plan": "Fail role boundaries together and restore dependencies in specified order; run the real discovery adapter against a controlled service.",
      "recovery_invariants": "Every retained request resolves or fails explicitly; resume with existing senders and no orphaned queues or false readiness.",
      "remaining_real_dependencies": "Nomad/Consul rescheduling, network identity and all-node power loss still need deployment checks."
    },
    "CombinedOrdering": {
      "real_actors": [
        "ingress",
        "sequencer admission",
        "sealer session adapter"
      ],
      "fault_plan": "Cut ingress/orderer boundaries in the case order; return peers in dependency order and reverse order; replay retained offers.",
      "recovery_invariants": "No lost or reordered sender prefix, no false acknowledgement, no dependency deadlock, exact recovery without new intake.",
      "remaining_real_dependencies": "The first sequencer fixture covers boundary assumptions only; real ingress composition and real Raft election closure remain pending."
    },
    "CombinedExec": {
      "real_actors": [
        "executor",
        "state writer",
        "validator",
        "ingress",
        "state mirror"
      ],
      "fault_plan": "Close reader/writer boundaries and remove account sources together; restore state and input in both orders.",
      "recovery_invariants": "Atomic durable boundary, state-root parity, no unsafe sender-floor assumption or balance rejection, bounded fallback.",
      "remaining_real_dependencies": "Requires real MDBX/commit actor and combined read-path fixtures; a mocked commit success is insufficient."
    },
    "L1": {
      "real_actors": [
        "L1 follower",
        "batcher",
        "validator"
      ],
      "fault_plan": "Serve controlled HTTP lies, missing receipts and retained history gaps; resume posting after upstream blackout.",
      "recovery_invariants": "Verify headers/receipts, preserve canonical positions, bounded retry, exact contiguous posting and no pruning of needed data.",
      "remaining_real_dependencies": "Wall-clock outages can be shortened only with a real clock seam or equivalent boundary-crossing evidence; contracts/retention still need integration checks."
    },
    "Follower": {
      "real_actors": [
        "L1 follower quorum",
        "provider client"
      ],
      "fault_plan": "Run real follower logic against independent controlled HTTP providers; inject timeout/refusal/disagreement and restart one or all actors.",
      "recovery_invariants": "Independent source deadlines and backoff, no false quorum, halt on disagreement and resume after valid replies.",
      "remaining_real_dependencies": "Single-provider mocks do not validate provider quorum or process restart; retain real protocol parsers."
    },
    "Cache": {
      "real_actors": [
        "state mirror",
        "ingress account/receipt reader",
        "Redis/Sentinel"
      ],
      "fault_plan": "Inject stale rows, partial writes, absent script, lookup timeout, lost connection and interrupted checkpoint scans; retain real checkpoint state.",
      "recovery_invariants": "Complete coverage before freshness, monotonic account updates, exact receipt identity, bounded executor fallback and rollback-safe rebuild.",
      "remaining_real_dependencies": "Real Lua/Redis transactions and Sentinel promotion need real local services; an in-memory dictionary cannot establish their semantics."
    },
    "Integrity": {
      "real_actors": [
        "executor and MDBX writer",
        "sealer recovery",
        "sequencer ownership"
      ],
      "fault_plan": "Repeat restart sequences against real temporary stores; restore from retained authoritative history; change ownership while traffic is pending.",
      "recovery_invariants": "Durable state survives restarts, duplicate/replayed data remains idempotent, ownership changes neither lose nor duplicate canonical transactions.",
      "remaining_real_dependencies": "Unflushed power-loss behavior and full-chain reseeding require real storage and protocol integration."
    },
    "Carry": {
      "real_actors": [
        "sequencer admission",
        "sealer rules",
        "egress",
        "executor readers"
      ],
      "fault_plan": "Drive actual feature/session/retention transitions while offers and reader requests are held; restart readers and outputs at each boundary.",
      "recovery_invariants": "Correct wire format at each version, retained offers replay safely, exact carry/reference parity and readable retained windows.",
      "remaining_real_dependencies": "The first admission fixture does not validate Java feature activation, deployed rollout order or complete carry/reference parity."
    },
    "Executor": {
      "real_actors": [
        "executor",
        "state writer",
        "checkpoint restore"
      ],
      "fault_plan": "Run real actors with controlled reader/writer failures and temporary MDBX/checkpoint files; interrupt writes, corrupt images and exhaust the checkpoint device.",
      "recovery_invariants": "No acknowledgement before durable commit, exact replay/state parity, reject corrupt bases, preserve data on failed recovery, remain cancellable.",
      "remaining_real_dependencies": "ENOSPC/EIO and process crash must be real fault effects; node replacement and image rollout remain deployment checks."
    },
    "Retention": {
      "real_actors": [
        "egress retention",
        "batcher",
        "validator",
        "DA guard",
        "canary"
      ],
      "fault_plan": "Hold posting or reader cursors beyond actual retention floors, resume requests, and drive halt/canary inputs through real actors.",
      "recovery_invariants": "No pruning of unposted required data, exact contiguous resumed output, correct halt and alert inhibition, no false healthy state.",
      "remaining_real_dependencies": "Mocked cursor values alone do not prove persisted coverage, contracts or alert-routing behavior."
    }
  },
