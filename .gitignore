target
mise.local.toml
.mise.local.toml
.ansible/
docs/superpowers
contracts/cache/
contracts/out/
contracts/lib/
contracts/foundry.lock

# benchmark and profiling artifacts
flame.folded
flame.svg
results/

.claude/*
!.claude/settings.json

# solc compiler blob (fetched, not source)
soljson-latest.js
contracts/soljson-latest.js

# python bytecode (e.g. deploy/cluster/scripts)
__pycache__/
*.pyc

# per-deploy image digest manifest (written by the image push step, read by
# deploy.sh; an audit record of one deploy, not source) + its cosign
# signature bundle (written by the CI signing step, P0.5)
deploy/cluster/images.digests
deploy/cluster/images.digests.sigbundle
# the record of the deployed manifests, per environment (written by the
# workloads role; `just rollback <env>` reads it)
deploy/cluster/deployed/


# dhat heap profiles written by crates/bench alloc_profile tests
crates/bench/dhat-heap*.json

# The Aeron jar that CI puts into the Aeron image build context
# (.github/actions/aeron-jar).
crates/log/docker/aeron/aeron-all.jar
