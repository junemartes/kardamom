  "panels": [
    {
      "gridPos": {"h": 5, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "code": {"language": "plaintext", "showLineNumbers": false, "showMiniMap": false},
        "content": "The DA proxy (eigenda-proxy) and the DA store export no metrics to Prometheus: the monitoring job has no scrape\ntarget for the kardamom-da-proxy service, the proxy runs without its metrics server, and kardamom-da-store has no\nexporter. There is no metric for the latency of a put or a get.\n\nThis page shows the DA traffic from its clients: the batcher disperses (POST /put), and the inbox indexer retrieves\n(GET /get) every posted batch. The proxy or store task itself shows through the Nomad agents.",
        "mode": "markdown"
      },
      "title": "What this page shows",
      "type": "text"
    },
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5}, "id": 2, "panels": [], "title": "Dispersal (batcher)", "type": "row"},
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "One batch is one put to the DA layer and one post of its certificate to L1.",
      "fieldConfig": {"defaults": {"custom": {"lineWidth": 1, "fillOpacity": 10}, "unit": "short", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 6},
      "id": 3,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "60 * rate(kardamom_batcher_batches_posted_total{host_id=~\"$host\"}[5m])",
          "legendFormat": "{{host_id}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Batches dispersed and posted (per minute)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"custom": {"lineWidth": 1, "fillOpacity": 10}, "unit": "Bps", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 6},
      "id": 4,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "rate(kardamom_batcher_payload_bytes_posted_total{host_id=~\"$host\"}[5m])",
          "legendFormat": "{{host_id}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Payload bytes dispersed",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"custom": {"lineWidth": 1, "fillOpacity": 10}, "unit": "bytes", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 6},
      "id": 5,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "increase(kardamom_batcher_payload_bytes_posted_total{host_id=~\"$host\"}[1h]) / increase(kardamom_batcher_batches_posted_total{host_id=~\"$host\"}[1h])",
          "legendFormat": "{{host_id}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Mean payload per batch (1h)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "A post retries when the DA put or the L1 send fails. The counter does not tell the two apart: read the batcher log.",
      "fieldConfig": {"defaults": {"custom": {"lineWidth": 1, "fillOpacity": 10}, "unit": "short", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 14},
      "id": 6,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "increase(kardamom_batcher_l1_post_retries_total{host_id=~\"$host\"}[10m])",
          "legendFormat": "post retries {{host_id}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "increase(kardamom_batcher_resume_failures_total{host_id=~\"$host\"}[10m])",
          "legendFormat": "resume failures {{host_id}}",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Post retries and resume failures (10m)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Closed blocks that wait for the group to fill or to flush.",
      "fieldConfig": {"defaults": {"custom": {"lineWidth": 1, "fillOpacity": 10}, "unit": "short", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 14},
      "id": 7,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "kardamom_batcher_pending_blocks{host_id=~\"$host\"}",
          "legendFormat": "{{host_id}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Dispersal backlog: blocks not posted",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"custom": {"lineWidth": 1, "fillOpacity": 10}, "unit": "s", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 14},
      "id": 8,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "kardamom_batcher_last_post_age_seconds{host_id=~\"$host\"}",
          "legendFormat": "age {{host_id}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "2 * kardamom_batcher_idle_flush_seconds{host_id=~\"$host\"}",
          "legendFormat": "alert threshold {{host_id}}",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Last post age on L1",
      "type": "timeseries"
    },
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 22}, "id": 9, "panels": [], "title": "Retrieval (inbox indexer)", "type": "row"},
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "The indexer gets the payload of each posted batch from the DA layer and archives it.",
      "fieldConfig": {"defaults": {"custom": {"lineWidth": 1, "fillOpacity": 10}, "unit": "short", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 23},
      "id": 10,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "60 * rate(kardamom_l1_indexer_batches_total{host_id=~\"$host\"}[5m])",
          "legendFormat": "{{host_id}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Batches retrieved (per minute)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"custom": {"lineWidth": 1, "fillOpacity": 10}, "unit": "Bps", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 23},
      "id": 11,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "rate(kardamom_l1_indexer_payload_bytes_total{host_id=~\"$host\"}[5m])",
          "legendFormat": "{{host_id}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Payload bytes retrieved",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "The batch index of the batcher's last post less the last batch the indexer archived. The indexer reads finalized L1 only, so a few batches of lag are normal.",
      "fieldConfig": {"defaults": {"custom": {"lineWidth": 1, "fillOpacity": 10}, "unit": "short", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 23},
      "id": 12,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "max(kardamom_batcher_last_batch_index) - max(kardamom_l1_indexer_last_batch_index)",
          "legendFormat": "batches",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Batches posted, not yet retrieved",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "A tick fails on an L1 error or a failed DA get. The KardamomL1IndexerTickErrors alert fires above 50% for 15m.",
      "fieldConfig": {
        "defaults": {
          "custom": {"lineWidth": 1, "fillOpacity": 10, "thresholdsStyle": {"mode": "line"}},
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 50}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 31},
      "id": 13,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "100 * sum by (host_id) (rate(kardamom_l1_indexer_tick_total{host_id=~\"$host\", outcome=\"error\"}[5m])) / sum by (host_id) (rate(kardamom_l1_indexer_tick_total{host_id=~\"$host\"}[5m]))",
          "legendFormat": "{{host_id}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Indexer ticks failed (%)",
      "type": "timeseries"
    },
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 39}, "id": 14, "panels": [], "title": "DA proxy or store task (Nomad)", "type": "row"},
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"custom": {"lineWidth": 1, "fillOpacity": 10}, "unit": "bytes", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 40},
      "id": 15,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (exported_job, node) (nomad_client_allocs_memory_usage{exported_job=~\"da-proxy|da-store\"})",
          "legendFormat": "{{exported_job}} {{node}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "max by (exported_job) (nomad_client_allocs_memory_allocated{exported_job=~\"da-proxy|da-store\"})",
          "legendFormat": "limit {{exported_job}}",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Task memory",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"custom": {"lineWidth": 1, "fillOpacity": 10}, "unit": "percent", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 40},
      "id": 16,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (exported_job, node) (nomad_client_allocs_cpu_total_percent{exported_job=~\"da-proxy|da-store\"})",
          "legendFormat": "{{exported_job}} {{node}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Task CPU (% of one core)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"custom": {"lineWidth": 1, "fillOpacity": 10}, "unit": "short", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 40},
      "id": 17,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (exported_job, node) (increase(nomad_client_allocs_restart{exported_job=~\"da-proxy|da-store\"}[10m]))",
          "legendFormat": "{{exported_job}} {{node}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Task restarts (10m)",
      "type": "timeseries"
    }
  ]
}
