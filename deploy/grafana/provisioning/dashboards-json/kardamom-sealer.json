{
  "annotations": {"list": []},
  "description": "The sealer runs as a Java Aeron Cluster (Raft) clustered service with no Prometheus endpoint of its own; every panel here reads the kardamom_sealer_* series the executors re-export as they decode the cluster's egress (boundary frames).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "refresh": "5s",
  "schemaVersion": 38,
  "tags": ["kardamom", "sealer", "cluster"],
  "time": {"from": "now-15m", "to": "now"},
  "timepicker": {},
  "timezone": "",
  "title": "Kardamom Sealer",
  "uid": "kardamom-sealer",
  "version": 1,
  "weekStart": "",
  "templating": {
    "list": [
      {
        "current": {"selected": false, "text": "All", "value": "$__all"},
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "definition": "label_values(kardamom_service_up, host_id)",
        "hide": 0,
        "includeAll": true,
        "label": "host",
        "multi": true,
        "name": "host",
        "options": [],
        "query": {"query": "label_values(kardamom_service_up, host_id)", "refId": "StandardVariableQuery"},
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 0,
        "type": "query"
      }
    ]
  },
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Rate of sealer block boundaries arriving at each executor's cluster-egress subscription. A healthy sealer ticks every 250 ms (~4 ops); all executor hosts should agree.",
      "fieldConfig": {"defaults": {"custom": {"lineWidth": 1, "fillOpacity": 10}, "unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (host_id) (rate(kardamom_sealer_boundaries_emitted_total{host_id=~\"$host\"}[1m]))",
          "legendFormat": "{{host_id}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Boundaries observed (1m rate per executor host)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "The sealer's declared block number from its latest boundary, as observed by each executor. Diverging hosts mean an executor's egress subscription is stalled or reconnecting.",
      "fieldConfig": {"defaults": {"custom": {"lineWidth": 1, "fillOpacity": 10}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "kardamom_sealer_block_number{host_id=~\"$host\"}",
          "legendFormat": "{{host_id}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Sealer block number (observed per executor host)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Per host: sealer's declared block minus the executor's last committed block. Both series come from the same executor process, so this is that executor's commit lag behind the cluster's boundary stream. Sustained growth means the executor cannot keep pace.",
      "fieldConfig": {"defaults": {"custom": {"lineWidth": 1, "fillOpacity": 40}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "id": 3,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "kardamom_sealer_block_number{host_id=~\"$host\"} - on(host_id) kardamom_executor_block_number{host_id=~\"$host\"}",
          "legendFormat": "{{host_id}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Executor lag behind sealer (blocks, per host)",
      "type": "timeseries"
    }
  ]
}
