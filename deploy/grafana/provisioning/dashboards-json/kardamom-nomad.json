      "title": "Nomad agents up",
      "type": "stat"
    },
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 4}, "id": 2, "panels": [], "title": "Allocations", "type": "row"},
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "The job summary of the Nomad leader. failed, lost and complete count the allocations that the garbage collector did not remove yet.",
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 10, "w": 12, "x": 0, "y": 5},
      "id": 3,
      "options": {"showHeader": true},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (exported_job) (nomad_nomad_job_summary_running{exported_job=~\"$nomad_job\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (exported_job) (nomad_nomad_job_summary_starting{exported_job=~\"$nomad_job\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "B"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (exported_job) (nomad_nomad_job_summary_queued{exported_job=~\"$nomad_job\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "C"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (exported_job) (nomad_nomad_job_summary_failed{exported_job=~\"$nomad_job\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "D"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (exported_job) (nomad_nomad_job_summary_lost{exported_job=~\"$nomad_job\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "E"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (exported_job) (nomad_nomad_job_summary_complete{exported_job=~\"$nomad_job\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "F"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (exported_job) (nomad_nomad_job_summary_unknown{exported_job=~\"$nomad_job\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "G"
        }
      ],
      "title": "Allocations by job and status",
      "transformations": [
        {"id": "merge", "options": {}},
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "__name__": true, "instance": true, "job": true},
            "indexByName": {},
            "renameByName": {
              "Value #A": "running",
              "Value #B": "starting",
              "Value #C": "queued",
              "Value #D": "failed",
              "Value #E": "lost",
              "Value #F": "complete",
              "Value #G": "unknown",
              "exported_job": "job"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"custom": {"lineWidth": 1, "fillOpacity": 10}, "unit": "short", "min": 0}, "overrides": []},
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 5},
      "id": 4,
      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (exported_job) (nomad_nomad_job_summary_running{exported_job=~\"$nomad_job\"})",
          "legendFormat": "{{exported_job}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Running allocations by job",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "From the job summary. A queued allocation finds no node with room.",
