          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "max by (service, host_id) (2 * (kardamom_halt == 1) or (kardamom_paused == 1) or 0 * kardamom_service_up)",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Service state",
      "transformations": [
        {
          "id": "organize",
          "options": {"excludeByName": {"Time": true, "__name__": true, "instance": true, "job": true}, "indexByName": {}, "renameByName": {"Value": "state"}}
