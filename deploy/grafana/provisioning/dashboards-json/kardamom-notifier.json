      "options": {"legend": {"calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (subscription) (kardamom_notifier_outbox_appended_total{host_id=~\"$host\"}) - sum by (subscription) (kardamom_notifier_outbox_delivered_total{host_id=~\"$host\"})",
          "legendFormat": "{{subscription}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Outbox depth (events appended minus finished, since start)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
