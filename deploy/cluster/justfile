# Cluster orchestration. Defaults mirror ansible/group_vars/all.yml;
# `just check-contract` verifies they stay in sync.
set shell := ["bash", "-euo", "pipefail", "-c"]

export REGISTRY := env('REGISTRY', 'registry.service.consul:5000')
export NOMAD_HTTP := env('NOMAD_HTTP', '4646')
export TAG := env('TAG', 'dev')
export DIGEST_MANIFEST := env('DIGEST_MANIFEST', 'images.digests')
export NODE_CONTRACT := env('NODE_CONTRACT', 'terraform/containers/node-contract.json')
export TF_CONTAINERS := env('TF_CONTAINERS', 'terraform/containers')
# KARDAMOM_STAGED=1 runs the binaries a build already staged under
# target/release (`just stage-dist`): the shard test
# executable as kardamom-chaos-shards and the operator binary. CI's shard
# runners carry no toolchain. Unset, cargo builds and runs them.
export KARDAMOM_STAGED := env('KARDAMOM_STAGED', '')
export CLUSTER_BIN := env('CLUSTER_BIN', if KARDAMOM_STAGED != '' { '../../target/release/kardamom-cluster' } else { 'cargo run --release -p kardamom-chaos --locked --bin kardamom-cluster --' })
export RUN_SHARDS := env('RUN_SHARDS', if KARDAMOM_STAGED != '' { '../../target/release/kardamom-chaos-shards' } else { 'cargo test -p kardamom-chaos --release --features cluster-e2e --locked --test shards --' })
# The Aeron stall tolerance of a container cluster, in milliseconds: the
# value of the cluster-e2e workflow and the local e2e harness. A shared
# CI or developer host stalls past Aeron's 10 s default at times. Only the
# container recipes set it; `deploy` keeps the 10 s production default.
container_stall_ms := env('AERON_STALL_TOLERANCE_MS', '30000')
# The epoch pace of a container cluster, in milliseconds: not the 2 s
# default of the da-watcher. The tests mine bursts of L1 blocks, and at
# 2 s a burst of 64 epochs takes about 128 s.
container_epoch_pace_ms := env('EPOCH_PACE_MS', '100')
# The idle cap of a container cluster, in microseconds: Aeron's own 1 ms
# park, not the 50 µs default of `deploy`. A cap at or above the own cap of
# a thread leaves the thread as it is, so at 1000 µs every thread keeps its
# old waits and the default timer slack. At 50 µs an idle media driver,
# sealer member or Rust Aeron thread uses about a fifth of a core or more,
# and a Rust Aeron thread under traffic uses about three times its old CPU.
# A container cluster runs about 20 of them on one shared CI or developer
# host, far above their Nomad cpu reservations.
container_idle_cap_us := env('KARDAMOM_IDLE_CAP_US', '1000')

_default:
    @just --list

# Wrap prebuilt service binaries and the sealer jar, then push their images.
images:
    ansible-playbook -i localhost, ansible/images.yml

# Converge workload jobs and settlement through Ansible.
deploy:
    ansible-playbook -i localhost, ansible/deploy.yml

# Roll an environment back one release: every job of the last release
# goes to its Nomad job version before that release, in reverse deploy
# order, under the waits of the deploy. The deploy record (the Nomad
# variable kardamom/deploys/<env>) names the release and the versions.
# The rollback refuses a rollback floor and a second rollback. The
# environment's NOMAD_ADDR and the other deploy settings come from the
# caller's environment, as for `deploy`. docs/runbooks/deploy-rollback.md
# is the runbook.
rollback env:
    KARDAMOM_ENV="{{ env }}" ansible-playbook -i localhost, ansible/rollback.yml

# Check that every sealer member reads snapshot version 14 and that every
# service runs a release that takes the upgrade transaction of `feature`
# (its feature id) at `activation_ms`. Run it before the Safe signs the
# upgrade transaction. It allows FEATURE_SEALER_V3 (feature id 2) only
# with the activation time 0. It records nothing.
# cluster/sealer-service/README.md ("Decision version") is the procedure.
sealer-upgrade-check env feature activation_ms="":
    KARDAMOM_ENV="{{ env }}" KARDAMOM_UPGRADE_FEATURE="{{ feature }}" KARDAMOM_UPGRADE_ACTIVATION_MS="{{ activation_ms }}" ansible-playbook -i localhost, ansible/upgrade-check.yml

# Re-render the release before the last one when Nomad dropped the job
# versions to revert to: a normal rolling deploy of the older images,
# under the same checks, from the manifest that a refused `just rollback`
# wrote (deployed/<env>/rollback.digests). The old binaries run with the
# job files of this checkout.
rollback-rerender env:
    #!/usr/bin/env bash
    set -euo pipefail
    manifest="deployed/{{ env }}/rollback.digests"
    if [[ ! -f "$manifest" ]]; then
        echo "no re-render manifest for {{ env }}: $manifest is missing; run \`just rollback {{ env }}\` first" >&2
        exit 1
    fi
    echo ">> re-rendering {{ env }} from:"
    cat "$manifest"
    KARDAMOM_ENV="{{ env }}" DIGEST_MANIFEST="$manifest" ansible-playbook -i localhost, ansible/deploy.yml

# Submit a signed transfer; RPC_URL overrides the node contract address.
smoke:
    #!/usr/bin/env bash
    set -euo pipefail
    args=()
    if [[ -n "${RPC_URL:-}" ]]; then args+=(--rpc "$RPC_URL"); fi
    $CLUSTER_BIN smoke "${args[@]}"

# Run all static deployment checks, reporting failures together.
validate:
    #!/usr/bin/env bash
    set -uo pipefail
    rc=0
    yamllint ansible/ || rc=1
    ansible-lint ansible/ || rc=1
    for job in nomad/*.hcl; do nomad job validate "$job" || rc=1; done
    ansible-playbook -i localhost, ansible/contract.yml || rc=1
    for root in terraform/*/; do
        tofu -chdir="$root" fmt -check -recursive . || rc=1
        tofu -chdir="$root" init -backend=false -input=false >/dev/null && tofu -chdir="$root" validate || rc=1
    done
    exit "$rc"

# Verify values mirrored from group_vars/all.yml.
check-contract:
    ansible-playbook -i localhost, ansible/contract.yml

# Remove local built images and the staged cluster jar.
clean:
    -docker image rm "$REGISTRY/kardamom-aeron:$TAG"
    -docker image rm "$REGISTRY/kardamom-cluster:$TAG"
    rm -f docker/kardamom-cluster-node.jar
    for svc in ingress sequencer executor validator da-watcher batcher state-mirror l1-indexer da-store l1-fault-proxy notifier canary egress; do docker image rm "$REGISTRY/kardamom-$svc:$TAG" || true; done

# Create nodes, provision them, publish prebuilt images and deploy workloads.
# CLUSTER_VARS is a JSON object passed as a single Ansible extra-vars argument.
container-up:
    #!/usr/bin/env bash
    set -euo pipefail
    export REGISTRY_PUSH_NODE="${REGISTRY_PUSH_NODE:-control-0}"
    export AERON_STALL_TOLERANCE_MS="{{container_stall_ms}}"
    export EPOCH_PACE_MS="{{container_epoch_pace_ms}}"
    export KARDAMOM_IDLE_CAP_US="{{container_idle_cap_us}}"
    # New nodes get a new sealer cluster. The deploy opens the bootstrap
    # only for a cluster job that Nomad does not know.
    export KARDAMOM_CLUSTER_BOOTSTRAP="${KARDAMOM_CLUSTER_BOOTSTRAP:-1}"
    tofu -chdir="$TF_CONTAINERS" init -input=false
    tofu -chdir="$TF_CONTAINERS" apply -auto-approve -input=false
    tofu -chdir="$TF_CONTAINERS" output -json node_contract > "$NODE_CONTRACT"
    control_address=$(jq -er '.nodes["control-0"].ip' "$NODE_CONTRACT")
    export NOMAD_ADDR="http://$control_address:$NOMAD_HTTP"
    args=()
    if [[ -n "${CLUSTER_VARS:-}" ]]; then args+=(--extra-vars "$CLUSTER_VARS"); fi
    ansible-playbook -i localhost, ansible/cluster.yml "${args[@]}"

# Run a shard against an existing cluster; KARDAMOM_CHAOS_CASES narrows cases.
# Shards: load, semantics, chaos-executor, chaos-ingress, chaos-sequencer,
# chaos-cluster, chaos-fleet, chaos-coordinated, chaos-combined-ordering,
# chaos-combined-exec, chaos-retention, chaos-cache, chaos-l1, chaos-follower,
# chaos-integrity (nightly).
container-test $shard=env('SHARD', 'load'):
    KARDAMOM_CHAOS_REUSE=1 AERON_STALL_TOLERANCE_MS="{{container_stall_ms}}" EPOCH_PACE_MS="{{container_epoch_pace_ms}}" KARDAMOM_IDLE_CAP_US="{{container_idle_cap_us}}" $RUN_SHARDS --ignored --exact "${shard//-/_}" --nocapture

# Run a shard end to end, including its cluster lifecycle, as CI does.
shard $shard=env('SHARD', 'load'):
    AERON_STALL_TOLERANCE_MS="{{container_stall_ms}}" EPOCH_PACE_MS="{{container_epoch_pace_ms}}" KARDAMOM_IDLE_CAP_US="{{container_idle_cap_us}}" $RUN_SHARDS --ignored --exact "${shard//-/_}" --nocapture

# Collect node and job state after a failure.
container-diagnostics:
    $CLUSTER_BIN diagnostics

# Destroy node containers and their volumes.
container-down:
    tofu -chdir="$TF_CONTAINERS" init -input=false
    tofu -chdir="$TF_CONTAINERS" destroy -auto-approve -input=false
    rm -f "$NODE_CONTRACT"

# Destroy, then create a fresh chain, in that order.
container-reset: container-down container-up
