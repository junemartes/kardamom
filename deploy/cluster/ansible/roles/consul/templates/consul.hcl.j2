# Managed by Ansible (roles/consul). Derives from group_vars/all.yml.
datacenter   = "{{ datacenter }}"
data_dir     = "/opt/consul"
bind_addr    = "{{ node_ip }}"
client_addr  = "{{ consul_client_addr }}"
# The join list is infrastructure DNS or the control node address, never
# a Consul service record: Consul must not bootstrap through itself.
retry_join   = {{ consul_retry_join | to_json }}

{% if control_plane | default(false) | bool %}
server           = true
bootstrap_expect = {{ consul_server_expect }}

ui_config {
  enabled = true
}
{% else %}
server = false
{% endif %}
{% if consul_gossip_key | length > 0 %}

encrypt                 = "{{ consul_gossip_key }}"
encrypt_verify_incoming = true
encrypt_verify_outgoing = true
{% endif %}
{% if consul_acl_enabled | bool %}

acl {
  enabled                  = true
  default_policy           = "deny"
  enable_token_persistence = true

  tokens {
    agent = "{{ consul_agent_token }}"
  }
}
{% endif %}
{% if consul_tls_dir | length > 0 %}

# TLS on the agent RPC path. The HTTP API stays on the loopback listener,
# so the local Nomad agent and the applications reach it without a client
# certificate.
tls {
  internal_rpc {
    ca_file                = "{{ consul_tls_dir }}/ca.pem"
    cert_file              = "{{ consul_tls_dir }}/cert.pem"
    key_file               = "{{ consul_tls_dir }}/key.pem"
    verify_incoming        = true
    verify_outgoing        = true
    verify_server_hostname = true
  }
}
{% endif %}
