# Managed by Ansible (roles/consul). Derives from group_vars/all.yml.
datacenter   = "{{ datacenter }}"
node_name    = "{{ kardamom_node }}"
data_dir     = "/opt/consul"
bind_addr    = "{{ node_ip }}"
client_addr  = "{{ consul_client_addr }}"

# Every node resolves cluster names through its own agent: the DNS
# listener is the node resolver on the loopback port 53, and every name
# outside the consul domain goes to the recursors in dns.hcl, the
# resolvers the host had before. Nothing in the deploy names an address;
# a dedicated node is <name>.node.{{ datacenter }}.consul and a service is
# <service>.service.consul.
addresses {
  dns = "127.0.0.1"
}
ports {
  dns = 53
}

# The HTTP connections that one client address may hold at a time. Every
# local process reaches the agent from 127.0.0.1, so for them this is a
# limit for the whole node. A kardamom process holds one blocking query
# for each service that it watches, and it passes a TTL check for each
# publication and subscription that it registers. The Nomad agent and the
# job templates add their own blocking queries. At the default of 200,
# the agents answer "429 Too Many Requests" under the chaos load, and the
# service registrations and check passes fail. 1024 is five times the
# default and far below the agent's LimitNOFILE of 65536.
limits {
  http_max_conns_per_client = {{ consul_http_max_conns_per_client }}
}

# The join list is infrastructure DNS or the control node address, never
# a Consul service record: Consul must not bootstrap through itself.
retry_join   = {{ consul_retry_join | to_json }}

# roles: the service classes this node hosts, a comma list (the same
# value as the Nomad node meta `roles`). A job template reads it from the
# catalog to find a node by its role before any service on that node is
# registered: the redis sentinels name the initial primary this way.
node_meta {
  roles = "{{ node_role_set | join(',') }}"
}

{% if control_plane | default(false) | bool %}
server           = true
bootstrap_expect = {{ consul_server_expect }}

ui_config {
  enabled = true
}
{% else %}
server = false
{% endif %}
{% if consul_gossip_key | length > 0 %}

encrypt                 = "{{ consul_gossip_key }}"
encrypt_verify_incoming = true
encrypt_verify_outgoing = true
{% endif %}
{% if consul_acl_enabled | bool %}

acl {
  enabled                  = true
  default_policy           = "deny"
  enable_token_persistence = true

  tokens {
    agent   = "{{ consul_agent_token }}"
    # DNS requests carry no token. The default token authorizes their reads.
    default = "{{ consul_dns_token }}"
  }
}
{% endif %}
{% if consul_tls_dir | length > 0 %}

# TLS on the agent RPC path. The HTTP API stays on the loopback listener,
# so the local Nomad agent and the applications reach it without a client
# certificate.
tls {
  internal_rpc {
    ca_file                = "{{ consul_tls_dir }}/ca.pem"
    cert_file              = "{{ consul_tls_dir }}/cert.pem"
    key_file               = "{{ consul_tls_dir }}/key.pem"
    verify_incoming        = true
    verify_outgoing        = true
    verify_server_hostname = true
  }
}
{% endif %}
