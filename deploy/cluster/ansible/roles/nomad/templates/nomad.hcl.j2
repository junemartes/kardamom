# Managed by Ansible (roles/nomad). Derives from group_vars/all.yml.
region     = "{{ nomad_region }}"
datacenter = "{{ datacenter }}"
data_dir   = "/opt/nomad"

bind_addr = "{{ node_ip }}"

advertise {
  http = "{{ node_ip }}"
  rpc  = "{{ node_ip }}"
  serf = "{{ node_ip }}"
}
{% if control_plane | default(false) | bool %}

server {
  enabled          = true
  bootstrap_expect = {{ nomad_server_expect }}
}
{% endif %}

client {
  enabled = true

  # The fingerprinted node address is node_ip's interface. Without this,
  # a node with a second network (the CI runner attaches Docker's default
  # bridge too) fingerprints the other one, and every Consul registration
  # and port mapping follows it.
  network_interface = "{{ '{{' }} GetAllInterfaces | include \"address\" \"{{ node_ip }}\" | attr \"name\" {{ '}}' }}"

  # Placement identity. node_class and node_pool carry the capacity pool
  # of an elastic node; a core node stays in the default pool. The
  # Autoscaler target selects nodes by node_class. A job selects a pool
  # with node_pool, so a core job cannot land on an elastic node.
  node_class = "{{ node_class | default(role) }}"
  node_pool  = "{{ node_pool | default('default') }}"
{% if deployment_profile == 'local' %}

  # Pin the CPU fingerprint on the local profile. Nomad derives a node's
  # total CPU compute from /proc/cpuinfo's "cpu MHz", which is ABSENT on
  # arm64 (Apple Silicon under Docker Desktop), so the fingerprint
  # collapses to ~0 and every task's `cpu` reservation "exhausts" the
  # node ("Dimension cpu exhausted"). A fixed compute budget lets the
  # scheduler place the collocated jobs; over-subscription across the
  # co-resident node containers is fine (the kernel time-shares the
  # cores). A production host reports its real capacity.
  cpu_total_compute = 16000
{% endif %}

  # role  = node class (unique placement: ${meta.role} == ingress, …)
  # tier  = coarse group (collocation/exclusion: aeron excludes
  #         ${meta.tier} == control).
  # node_ip and node_index feed the jobs that still form an endpoint or
  # a host id from the node. Their removal belongs to the dynamic MDC
  # cutover; until then every profile stamps them.
  meta {
    kardamom_node = "{{ kardamom_node }}"
    cluster_id    = "{{ cluster_id }}"
    role          = "{{ role }}"
    tier          = "{{ tier }}"
    pool          = "{{ node_pool | default('default') }}"
    # node_ip: this node's private address. sequencer.nomad.hcl and
    # executor.nomad.hcl form the cluster egress endpoint <node_ip>:402x0
    # from it.
    node_ip       = "{{ node_ip }}"
    # node_index: this node's 0-based index within its class (the <i> of
    # <class>-<i>). sequencer.nomad.hcl forms KARDAMOM_HOST_ID from it.
    node_index    = "{{ node_index | default(sequencer_id | default('0')) }}"
    # archive_topics: the topics this node's Aeron archive records, for
    # the kardamom-aeron-archive service record (nomad/aeron.system.nomad.hcl).
    # The ingress nodes record tx_data, the aux node records tx_deposits.
    archive_topics = "{{ 'tx_data' if role == 'ingress' else ('tx_deposits' if role == 'aux' else '') }}"
  }
}

consul {
  address = "127.0.0.1:{{ ports.consul_http }}"
  # Nomad servers and clients find each other through the local Consul
  # agent. There is no static server list. The service names carry the
  # cluster_id, so two clusters in one Consul datacenter cannot join.
  auto_advertise      = true
  server_auto_join    = true
  client_auto_join    = true
  server_service_name = "{{ cluster_id }}-nomad"
  client_service_name = "{{ cluster_id }}-nomad-client"
{% if nomad_consul_token | length > 0 %}
  token               = "{{ nomad_consul_token }}"
{% endif %}
}
{% if nomad_acl_enabled | bool %}

acl {
  enabled = true
}
{% endif %}
{% if nomad_tls_dir | length > 0 %}

tls {
  http = true
  rpc  = true

  ca_file   = "{{ nomad_tls_dir }}/ca.pem"
  cert_file = "{{ nomad_tls_dir }}/cert.pem"
  key_file  = "{{ nomad_tls_dir }}/key.pem"

  verify_server_hostname = true
  verify_https_client    = false
}
{% endif %}

# volumes.enabled is REQUIRED: it defaults to false, and every kardamom job
# bind-mounts host paths (the shared Aeron tmpfs, archive/state dirs) via the
# docker driver's `volumes` list — placements fail without it. Nothing needs
# privileged containers or raw_exec, so neither is enabled.
plugin "docker" {
  config {
    volumes {
      enabled = true
    }
  }
}
