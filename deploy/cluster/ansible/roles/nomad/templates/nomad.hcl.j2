# Managed by Ansible (roles/nomad). Derives from group_vars/all.yml.
datacenter = "dc1"
data_dir   = "/opt/nomad"

bind_addr = "{{ node_ip }}"

advertise {
  http = "{{ node_ip }}"
  rpc  = "{{ node_ip }}"
  serf = "{{ node_ip }}"
}

server {
  enabled          = {{ 'true' if inventory_hostname in groups['control'] else 'false' }}
  bootstrap_expect = 1
}

client {
  enabled    = true
  servers    = ["{{ control_ip }}:{{ ports.nomad_rpc }}"]

  # Pin the CPU fingerprint. Nomad derives a node's total CPU compute from
  # /proc/cpuinfo's "cpu MHz", which is ABSENT on arm64 (Apple Silicon under
  # Docker Desktop) — so the fingerprint collapses to ~0 and every task's `cpu`
  # reservation "exhausts" the node ("Dimension cpu exhausted"). A fixed compute
  # budget lets the scheduler place the collocated jobs; over-subscription across
  # the co-resident node containers is fine (the kernel time-shares the cores).
  cpu_total_compute = 16000

  # role  = node class (unique placement: ${meta.role} == ingress, …)
  # tier  = coarse group (collocation/exclusion: recorders + aeron target
  #         ${meta.tier} == worker; aeron excludes ${meta.tier} == control).
  # Per-replica identity (recorder_id) comes from ${NOMAD_ALLOC_INDEX} in the
  # count-based jobs; the sequencer job instead derives its partition from
  # ${meta.node_index} (deterministic replica-group cross-placement).
  meta {
    kardamom_node = "{{ kardamom_node }}"
    role          = "{{ role }}"
    tier          = "{{ tier }}"
    # node_ip: this node's cluster IP. Used by sequencer.nomad.hcl / sealer to
    # form the tx_ordering MDC control endpoint <node_ip>:{{ tx_ordering_mdc_port }}.
    node_ip       = "{{ node_ip }}"
    # node_index: this node's 0-based index within its class (the <i> of
    # kardamom-<class>-<i>, or the inventory's explicit node_index/sequencer_id
    # var). Gives jobs a DETERMINISTIC node-derived identity —
    # sequencer.nomad.hcl uses it as the partition index so its two replica
    # groups cross-place shards without depending on alloc-index luck.
    node_index    = "{{ node_index | default(sequencer_id | default('0')) }}"
  }
}

consul {
  address = "127.0.0.1:{{ ports.consul_http }}"
}

# volumes.enabled is REQUIRED: it defaults to false, and every kardamom job
# bind-mounts host paths (the shared Aeron tmpfs, archive/state dirs) via the
# docker driver's `volumes` list — placements fail without it. Nothing needs
# privileged containers or raw_exec, so neither is enabled.
plugin "docker" {
  config {
    volumes {
      enabled = true
    }
  }
}
