# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# 12-node kardamom cluster. Mirrors the node-class model in
# ansible/group_vars/all.yml (node_classes — the canonical contract): nodes are
# <class>-<i> at ip_prefix.<ip_start+i>, matching ansible/inventory.ini and the
# containers scripts/ci-cluster.sh materialises for CI. libvirt is the primary
# provider; VirtualBox is a best-effort fallback. Static private IPs on
# 192.168.56.0/24.
#
#   vagrant up               # boot all 12 VMs
#   vagrant up executor-0    # boot one
#   vagrant destroy -f       # tear down

# One node class per role (control / sequencer / ingress / executor / sealer /
# aux — keep in sync with node_classes). Memory sizing: each VM must fit the
# sum of the Nomad task `memory` reservations placed on it (see
# nomad/*.nomad.hcl) plus OS/agent overhead. The control node runs no Aeron
# driver (registry + anvil only); every other node runs the trimmed Aeron
# media driver plus its own service — executor nodes carry the largest single
# service, hence 2560; sealer nodes run the JVM Aeron Cluster member + archive.
NODES = [
  { name: "control-0",   ip: "192.168.56.10", cpus: 2, mem: 2048, role: "control"   },
  { name: "sequencer-0", ip: "192.168.56.21", cpus: 2, mem: 1280, role: "sequencer" },
  { name: "sequencer-1", ip: "192.168.56.22", cpus: 2, mem: 1280, role: "sequencer" },
  { name: "ingress-0",   ip: "192.168.56.31", cpus: 2, mem: 1280, role: "ingress"   },
  { name: "ingress-1",   ip: "192.168.56.32", cpus: 2, mem: 1280, role: "ingress"   },
  { name: "executor-0",  ip: "192.168.56.41", cpus: 2, mem: 2560, role: "executor"  },
  { name: "executor-1",  ip: "192.168.56.42", cpus: 2, mem: 2560, role: "executor"  },
  { name: "executor-2",  ip: "192.168.56.43", cpus: 2, mem: 2560, role: "executor"  },
  { name: "sealer-0",    ip: "192.168.56.51", cpus: 2, mem: 2048, role: "sealer"    },
  { name: "sealer-1",    ip: "192.168.56.52", cpus: 2, mem: 2048, role: "sealer"    },
  { name: "sealer-2",    ip: "192.168.56.53", cpus: 2, mem: 2048, role: "sealer"    },
  { name: "aux-0",       ip: "192.168.56.61", cpus: 2, mem: 2048, role: "aux"       },
]

Vagrant.configure("2") do |config|
  # generic/ubuntu2204 is the one widely-mirrored box that publishes BOTH
  # libvirt and virtualbox providers (bento/ubuntu-22.04 has no libvirt build).
  # The "generic" box project is in maintenance mode; if it disappears, pick a
  # jammy box per provider and update ubuntu_codename in group_vars/all.yml.
  config.vm.box = "generic/ubuntu2204"

  # Use the shared Vagrant insecure key on every VM instead of per-machine
  # generated keys: ansible/site.yml is run ONCE against all hosts (see the
  # provisioner below and `make provision`), and a single run can only
  # authenticate everywhere if all hosts accept the same key
  # (~/.vagrant.d/insecure_private_key, wired up in ansible/ansible.cfg).
  config.ssh.insert_key = false

  NODES.each_with_index do |node, idx|
    config.vm.define node[:name] do |vm|
      vm.vm.hostname = node[:name]
      vm.vm.network "private_network", ip: node[:ip]

      vm.vm.provider :libvirt do |lv|
        lv.cpus   = node[:cpus]
        lv.memory = node[:mem]
      end

      vm.vm.provider :virtualbox do |vb|
        vb.cpus   = node[:cpus]
        vb.memory = node[:mem]
      end

      # Provision with Ansible only once, from the last VM, so the playbook
      # sees the whole inventory in a single run.
      if idx == NODES.size - 1
        vm.vm.provision :ansible do |ansible|
          ansible.playbook       = "ansible/site.yml"
          ansible.inventory_path = "ansible/inventory.ini"
          ansible.limit          = "all"
          ansible.compatibility_mode = "2.0"
        end
      end
    end
  end
end
