# yamllint config for the cluster Ansible tree (see cluster-validate CI).
# The non-default rules below match what ansible-lint's bundled yaml rule
# requires, so both tools agree.
extends: default

rules:
  # Prose-heavy comments and templated download URLs (e.g. the HashiCorp
  # release URLs, with two version + an arch substitution) don't fit in 120.
  line-length:
    max: 160
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
